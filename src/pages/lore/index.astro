---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const entries = (await getCollection("lore", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="World"
  description="The districts, factions, and history of Blackout."
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">The world</h1>
    <p class="mt-4 text-lg text-ink-dim">
      Places you can walk to, and the history that put them there.
    </p>

    {
      entries.length === 0 ? (
        <p class="mt-16 font-mono text-sm text-ink-faint">Nothing published yet.</p>
      ) : (
        <ul class="mt-14 space-y-px overflow-hidden rounded-lg border border-edge bg-edge">
          {entries.map((entry) => (
            <li>
              <a
                href={`/lore/${entry.id}`}
                class="group block bg-surface p-6 transition hover:bg-surface-2"
              >
                <h2 class="font-display text-lg font-semibold text-ink transition group-hover:text-signal">
                  {entry.data.title}
                </h2>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                  {entry.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
