---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Devlog"
  description="Build notes from Blackout — systems, formulas, and the things that broke."
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">Devlog</h1>
    <p class="mt-4 text-lg text-ink-dim">
      Build notes, systems design, and the occasional postmortem on something that
      broke in an interesting way.
    </p>

    {
      posts.length === 0 ? (
        <p class="mt-16 font-mono text-sm text-ink-faint">No posts yet.</p>
      ) : (
        <ul class="mt-14 space-y-10">
          {posts.map((post) => (
            <li class="border-b border-edge/70 pb-10 last:border-0">
              <time
                datetime={post.data.date.toISOString()}
                class="font-mono text-xs text-ink-faint"
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </time>
              <h2 class="mt-2 font-display text-2xl font-semibold">
                <a
                  href={`/blog/${post.id}`}
                  class="text-ink transition hover:text-signal"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 leading-relaxed text-ink-dim">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full border border-edge px-2.5 py-1 font-mono text-xs lowercase text-ink-faint">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
