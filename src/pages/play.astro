---
import Base from "../layouts/Base.astro";
import { GAME_URL, LEGACY_CLIENT_URL, DISCORD_URL } from "../config";

const steps = [
  "Click the button. The client opens in a new tab and loads itself once, then starts.",
  "Use the form at the top of the text column: pick a name and a password, then Create. Connect if you already have one. On a locked-down browser the Paste button fills the password field.",
  'Type `look` to see where you are, and `help` for the command list (look for the "Blackout:" prefix).',
  "Click a tile in the 3D pane to walk there. Click an NPC to attack it, an item to pick it up, a gathering node to cut it — whatever the game says you can do with a thing is what clicking it does.",
  "Press Escape to hand the keyboard to the map and move with the movement keys; Enter gives it back to the input. The input box tells you which mode you are in.",
  "Drag an inventory cell onto another to swap, onto a body slot to equip, off one to unequip. Right-click a cell for that item’s own actions.",
  "Character, Options and ? are buttons above the log. Ctrl+F searches the log. 3D hides both panes if you would rather play it as plain text.",
];
---

<Base
  title="Play"
  description="Play Blackout in your browser. No download, no install — the client runs over a websocket."
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">Jack in</h1>
    <p class="mt-4 text-lg text-ink-dim">
      Blackout runs entirely in your browser. There is no launcher and no account
      to make on this site. Your character <em>is</em> your account.
    </p>

    <a
      href={GAME_URL}
      class="mt-10 flex items-center justify-between gap-4 rounded-lg border border-signal/40 bg-surface p-6 transition hover:border-signal hover:bg-surface-2"
    >
      <span>
        <span class="block font-display text-xl font-semibold text-signal">
          Open the client
        </span>
        <span class="mt-1 block font-mono text-xs text-ink-faint">
          playblackout.io/client
        </span>
      </span>
      <span class="text-2xl text-signal" aria-hidden="true">&rarr;</span>
    </a>

    <h2 class="mt-16 font-display text-xl font-semibold text-ink">First few minutes</h2>
    <ol class="mt-5 space-y-4">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-edge font-mono text-xs text-signal">
              {i + 1}
            </span>
            <span class="text-ink-dim" set:html={step.replace(/`([^`]+)`/g, '<code class="rounded border border-edge bg-surface-2 px-1.5 py-0.5 font-mono text-sm text-ink">$1</code>')} />
          </li>
        ))
      }
    </ol>

    <div class="mt-14 rounded-lg border border-edge bg-surface p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Server offline?</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">
        Blackout is in active development and the game server occasionally restarts
        for updates. If the client will not connect, just wait a few minutes...or hours.
      </p>
    </div>

    <div class="mt-8 rounded-lg border border-edge bg-surface p-6">
      <h2 class="font-display text-lg font-semibold text-ink">If the 3D client will not start</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">
        It needs WebGL2, and a browser without it gets a blank page rather than a
        polite error. The <a class="text-signal underline" href={LEGACY_CLIENT_URL}>older
        browser client</a> is still running and still playable &mdash; its 3D panes are
        optional, so it works where this one does not.
      </p>
    </div>

    <div class="mt-8 rounded-lg border border-edge bg-surface p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Traditional MUD clients</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">
        Not supported yet. Mudlet, TinTin++, and the rest connect over raw telnet,
        which the current hosting setup cannot expose publicly. The browser client
        is the only way in for now.
      </p>
    </div>
  </section>
</Base>
