---
import { BRAND_MARK, SITE, NAV_LINKS } from "../config";

const { pathname } = Astro.url;
---

<header
  class="sticky top-0 z-50 border-b border-edge/70 bg-void/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
    aria-label="Main"
  >
    <a
      href="/"
      class="group flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-ink"
    >
      <img
        src={BRAND_MARK.small}
        alt=""
        aria-hidden="true"
        width="32"
        height="32"
        class="h-8 w-8 shrink-0 transition duration-200 group-hover:brightness-110 group-hover:drop-shadow-[0_0_8px_rgba(170,12,18,0.85)]"
      />
      {SITE.name}
    </a>

    <ul class="flex items-center gap-1 text-sm">
      {
        NAV_LINKS.map((link) => {
          const isActive = pathname === link.href || pathname.startsWith(link.href + "/");
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 transition hover:text-ink",
                  isActive ? "text-signal" : "text-ink-dim",
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
