---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  /** Where the "back" link points, e.g. "/blog". */
  backHref: string;
  backLabel: string;
}

const { title, description, date, tags = [], backHref, backLabel } = Astro.props;

const dateLabel = date
  ? date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
  : null;
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-2xl px-6 py-16">
    <a
      href={backHref}
      class="mb-10 inline-flex items-center gap-2 text-sm text-ink-faint transition hover:text-signal"
    >
      <span aria-hidden="true">&larr;</span>
      {backLabel}
    </a>

    <header class="mb-10 border-b border-edge/70 pb-8">
      <h1 class="text-3xl font-bold text-ink sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-ink-dim">{description}</p>

      {
        (dateLabel || tags.length > 0) && (
          <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-ink-faint">
            {dateLabel && (
              <time datetime={date?.toISOString()} class="font-mono">
                {dateLabel}
              </time>
            )}
            {tags.map((tag) => (
              <span class="rounded-full border border-edge px-2.5 py-1 font-mono lowercase">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose-blackout">
      <slot />
    </div>
  </article>
</Base>
